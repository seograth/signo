# Signo Environment Configuration Template
# Copy this file to '.env.local' or '.env' for local development override.

# Vite Development Server Port
VITE_PORT=5173

# Public Host / Base URL
VITE_PUBLIC_URL=http://localhost:5173

# Feature Flags
VITE_ENABLE_DEBUG_WORKER=false
VITE_ENABLE_SKELETON_GLOW=true

# Feature Flag: Enables the interactive 3D Hand Pose Designer & Landmark Extraction Drawer
# Set to 'true' to enable during local development; defaults to 'false' in production builds.
VITE_ENABLE_POSE_EDITOR=false
